# Copy via `pnpm env:init` — values marked __GENERATED__ are filled with random local secrets.
# Local development only. Never reuse these values in a hosted environment.

############
# Secrets
############
POSTGRES_PASSWORD=__GENERATED__
JWT_SECRET=__GENERATED__
ANON_KEY=__GENERATED__
SERVICE_ROLE_KEY=__GENERATED__
PG_META_CRYPTO_KEY=__GENERATED__

############
# Ports on your machine
############
WEB_PORT=4000
API_PORT=8000
STUDIO_PORT=4001
MAIL_UI_PORT=8025
DB_PORT=54322

############
# URLs as seen from the browser
############
# If you test from a phone with Expo Go, set these to http://<your-LAN-IP>:<port>.
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:4000

############
# Auth
############
JWT_EXPIRY=3600
# OTP e-mails go to Mailpit (http://localhost:8025); nothing leaves your machine.
SMTP_ADMIN_EMAIL=no-reply@hiremyjunior.local
SMTP_SENDER_NAME=HireMyJunior

############
# Verification vendors (Phase 3) — leave blank to use local simulation.
############
# Twilio Verify (phone codes). Blank → codes appear in Mailpit as "SMS to +1…".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Stripe Identity (government ID + selfie). Blank → a local pass/fail page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkr (background checks). Blank → an admin completes the check from the review queue.
CHECKR_API_KEY=
CHECKR_PACKAGE=basic_criminal

############
# Phone sign-in
############
# Local testing: every phone number accepts this 4-digit code. Leave blank to receive real codes
# (Mailpit locally, or Twilio Verify when TWILIO_* is set — then this setting is ignored).
# With Twilio, set your Verify service's code length to 4.
PHONE_LOGIN_TEST_CODE=0000
